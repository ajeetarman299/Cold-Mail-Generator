# Copy this file to .env and add your key from https://console.groq.com/keys
# Without a key (or with this placeholder), the app runs in demo mode.
GROQ_API_KEY=your_groq_api_key_here

# Optional: any current Groq model id (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: User-Agent header sent when fetching job pages
# USER_AGENT=Mozilla/5.0 (compatible; cold-mail-generator/2.0)
